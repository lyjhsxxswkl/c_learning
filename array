#include <stdio.h>
#define NUMBER 80

int main()
{
    int i,j;
    int rs;
    int fs[NUMBER];
    int fbt[11]={0};
    do{
            printf("Please input the number of student :");
            scanf("%d",&rs);
            if (rs<=0||rs>80){
                puts("An integer between 0 and 80, thanks :) .");
            }
    }while (rs<=0||rs>80);

    printf("Please input score\n");

    for (i=0;i<rs;i++){
        do{
                printf("The number %d :",i+1);
                scanf("%d",&fs[i]);
                if (fs[i]<0||fs[i]>100){
                    puts("An integer between 0 and 100");
                }
        }while (fs[i]<0||fs[i]>100);
    fbt[fs[i]/10]++;
    }

    printf("---distribution chart---\n");

    printf("  100 :");
    for (j=0;j<fbt[10];j++){
        putchar('*');
    }
    putchar('\n');
        for(i=9;i>=0;i--){
        printf("%d-%d :",i*10,i*10+9);
        for (j=0;j<fbt[i];j++){
            putchar('*');
        }
        printf("\n");
    }
    return 0;
}
